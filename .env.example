# Copy to .env and fill in values
FLASK_DEBUG=true
# Required when FLASK_DEBUG is false. Generate long random values; never reuse development values.
FLASK_SECRET_KEY=
JWT_SECRET_KEY=
FERNET_KEY=
REDIS_URL=redis://localhost:6379/0
USE_RQ_WORKERS=false

# Seconds to wait for manual CAPTCHA/2FA in visible Chrome (default 600 = 10 min)
FB_MANUAL_VERIFICATION_TIMEOUT=600

# With USE_RQ_WORKERS=true run separate workers:
# ./start_platform.sh analytics-worker  # post metrics (queue: analytics)

# Optional bot overrides (prefer per-user credentials in dashboard)
FB_USERNAME=
FB_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rate limits (defaults if account limits are 0)
DEFAULT_HOURLY_POST_LIMIT=15
DEFAULT_DAILY_POST_LIMIT=80
ACCOUNT_COOLDOWN_MINUTES=30
MAX_CONSECUTIVE_FAILURES=3
