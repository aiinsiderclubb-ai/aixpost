# Copy to .env and fill in values
FLASK_DEBUG=true
FLASK_ENV=development

# Required when FLASK_DEBUG is false / in Docker. Generate long random values.
FLASK_SECRET_KEY=
JWT_SECRET_KEY=
FERNET_KEY=

REDIS_URL=redis://localhost:6379/0
USE_RQ_WORKERS=false

# App DB: leave unset for local SQLite (APP_SQLITE_PATH).
# Docker Compose sets this to Postgres automatically.
# DATABASE_URL=postgresql://aipostx:change-me@localhost:5432/aipostx
APP_SQLITE_PATH=
# SQLite fallback for RuntimeStore (used when DATABASE_URL is unset).
RUNTIME_DB_PATH=
# Optional dedicated runtime Postgres URL. If empty and RUNTIME_USE_APP_DB=true,
# RuntimeStore shares DATABASE_URL (multi-host web/worker).
# RUNTIME_DATABASE_URL=
RUNTIME_USE_APP_DB=true

# Docker Compose Postgres (required when using compose)
POSTGRES_USER=aipostx
POSTGRES_PASSWORD=
POSTGRES_DB=aipostx

# Seconds to wait for manual CAPTCHA/2FA in visible Chrome (default 600 = 10 min)
FB_MANUAL_VERIFICATION_TIMEOUT=600

# Optional bot overrides (prefer per-user credentials in dashboard)
FB_USERNAME=
FB_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily analytics digest time (UTC), default 20:00
TELEGRAM_DIGEST_AT=20:00

# Rate limits / anti-ban (safe defaults for new accounts)
DEFAULT_HOURLY_POST_LIMIT=5
DEFAULT_DAILY_POST_LIMIT=25
HARD_MAX_HOURLY_POST_LIMIT=20
HARD_MAX_DAILY_POST_LIMIT=80
ACCOUNT_COOLDOWN_MINUTES=60
MAX_CONSECUTIVE_FAILURES=2
# Warm-up: first N days after account creation use stricter caps
ACCOUNT_WARMUP_DAYS=7
WARMUP_HOURLY_POST_LIMIT=3
WARMUP_DAILY_POST_LIMIT=12
# Hard-stop posting queue on checkpoint / 2FA / captcha
AUTO_STOP_ON_VERIFICATION=true
# Long-poll Telegram for /schedule /jobs /cancel (needs TELEGRAM_BOT_TOKEN)
TELEGRAM_BOT_POLLING=true
# Cloud Prepare via noVNC browser worker (public URL of Docker web service)
# NOVNC_PUBLIC_URL=https://aixpost-browser.onrender.com
# ALLOW_CLOUD_PREPARE=true

# Optional bootstrap admin (created once on first start)
INITIAL_ADMIN_EMAIL=admin@test.com
INITIAL_ADMIN_PASSWORD=
